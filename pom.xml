<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.landfairy</groupId>
	<artifactId>tiny-spring-tdd</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>tiny-spring-tdd</name>
	<description>从 0 手写 Spring：TDD 驱动的渐进式源码教学项目</description>
	<url>https://github.com/Land-Fairy/tiny-spring-tdd</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>Land-Fairy</id>
			<name>LandFairy</name>
			<url>https://github.com/Land-Fairy</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/Land-Fairy/tiny-spring-tdd.git</connection>
		<developerConnection>scm:git:git@github.com:Land-Fairy/tiny-spring-tdd.git</developerConnection>
		<url>https://github.com/Land-Fairy/tiny-spring-tdd</url>
	</scm>

	<properties>
		<!-- 与真实 Spring Framework 6.2.x 的基线对齐：JDK 17 起步 -->
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- 教学基线：对照的真实 Spring 版本（行号引用以此为准） -->
		<spring-framework.reference.version>6.2.x</spring-framework.reference.version>

		<!-- 测试与质量工具版本 -->
		<junit.version>5.11.4</junit.version>
		<assertj.version>3.26.3</assertj.version>
		<mockito.version>5.14.2</mockito.version>

		<!-- 插件版本 -->
		<maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
		<maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
		<maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<checkstyle.version>10.21.4</checkstyle.version>
		<maven-pmd-plugin.version>3.26.0</maven-pmd-plugin.version>
		<jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
		<spring-javaformat.version>0.0.43</spring-javaformat.version>

		<!-- 覆盖率门槛（见 docs/CODE-STANDARDS.md） -->
		<coverage.line.minimum>0.80</coverage.line.minimum>
		<coverage.branch.minimum>0.70</coverage.branch.minimum>
	</properties>

	<modules>
		<!-- 章节模块按教学顺序依次加入；每个目录都是一个可独立运行的历史快照 -->
		<module>step-01-map-container</module>
		<module>step-02-bean-definition</module>
		<module>step-03-singleton-registry</module>
		<module>step-04-constructor-injection</module>
		<module>step-05-property-injection</module>
		<module>step-06-bean-factory-hierarchy</module>
		<module>step-07-resource</module>
		<module>step-08-xml-reader</module>
		<module>step-09-application-context</module>
		<module>step-10-bean-factory-post-processor</module>
		<module>step-11-bean-post-processor</module>
		<module>step-12-aware</module>
		<module>step-13-lifecycle</module>
		<module>step-14-scope-factorybean</module>
		<module>step-15-events</module>
		<module>step-16-ordered</module>
		<module>step-17-classpath-scanning</module>
		<module>step-18-resource-pattern</module>
		<module>step-19-autowire-candidates</module>
		<module>step-20-value-descriptor</module>
		<module>step-21-configuration</module>
		<module>step-22-assembly-control</module>
		<module>step-23-conversion-service</module>
		<module>step-24-jdk-proxy</module>
		<module>step-25-advisor</module>
		<module>step-26-autoproxy</module>
		<module>step-27-proxy-population</module>
		<module>step-28-expose-proxy</module>
		<module>step-29-aop-pitfalls</module>
		<module>step-30-circular-dependencies</module>
		<module>step-31-concurrency</module>
		<module>step-32-getbean-flow</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.assertj</groupId>
				<artifactId>assertj-core</artifactId>
				<version>${assertj.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-core</artifactId>
				<version>${mockito.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-junit-jupiter</artifactId>
				<version>${mockito.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!--
					关键：开启 -parameters，把构造参数名保留到字节码里。
					这是本项目不使用 CGLIB 仍能按参数名完成构造器注入的前提（见 ADR-0002）。
					注意 -parameters 是 javac 的编译期参数，绝不能放进 surefire 的 argLine（那是 JVM 参数）。
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<parameters>true</parameters>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- 闸门 1：格式（Spring 官方风格，Tab 缩进） -->
			<plugin>
				<groupId>io.spring.javaformat</groupId>
				<artifactId>spring-javaformat-maven-plugin</artifactId>
				<version>${spring-javaformat.version}</version>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>validate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- 闸门 2：环境与依赖红线 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer-plugin.version}</version>
				<executions>
					<execution>
						<id>enforce-toolchain-and-dependencies</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[17,22)</version>
									<message>本项目以 JDK 17 为编译基线，支持 17~21。</message>
								</requireJavaVersion>
								<bannedDependencies>
									<excludes>
										<!-- 包名伪装成 org.springframework，一旦混入真实 Spring 就会 split package -->
										<exclude>org.springframework*:*</exclude>
										<exclude>org.springframework.boot:*</exclude>
									</excludes>
									<message>
										教学项目禁止在 classpath 上出现真实 Spring：本项目的包名与真实 Spring 重叠，
										两者共存会导致 split package 与难以排查的类加载问题。
									</message>
								</bannedDependencies>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- 闸门 3：编码规范 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${maven-checkstyle-plugin.version}</version>
				<configuration>
					<configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<consoleOutput>true</consoleOutput>
					<failOnViolation>true</failOnViolation>
					<violationSeverity>warning</violationSeverity>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>${checkstyle.version}</version>
					</dependency>
				</dependencies>
			</plugin>

			<!-- 闸门 4：优雅度（curated PMD 规则） -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${maven-pmd-plugin.version}</version>
				<configuration>
					<rulesets>
						<ruleset>${maven.multiModuleProjectDirectory}/config/pmd/pmd-ruleset.xml</ruleset>
					</rulesets>
					<printFailingErrors>true</printFailingErrors>
					<includeTests>true</includeTests>
					<linkXRef>false</linkXRef>
				</configuration>
				<executions>
					<execution>
						<id>pmd-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- 闸门 5：测试覆盖率 -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.line.minimum}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.branch.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
