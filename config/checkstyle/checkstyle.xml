<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
	tiny-spring-tdd 编码规范（机器可判定部分）。
	设计原则：只拦"会让读者困惑"的东西，不为了严格而严格。
	每条规则的用意见 docs/CODE-STANDARDS.md。
-->
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<property name="severity" value="error"/>
	<property name="fileExtensions" value="java"/>

	<!--
		注意：这里刻意 *不* 启用 FileTabCharacter。
		spring-javaformat（闸门 1）强制 Spring 官方风格，缩进用 Tab；
		若在此禁止 Tab，两条闸门会互相矛盾。
		缩进一致性交由 spring-javaformat 保证。
	-->
	<module name="NewlineAtEndOfFile">
		<property name="lineSeparator" value="lf"/>
	</module>

	<module name="RegexpSingleline">
		<property name="format" value="\s+$"/>
		<property name="message" value="行尾不应有空白字符。"/>
	</module>

	<module name="TreeWalker">
		<!-- ===== 导入 ===== -->
		<module name="AvoidStarImport">
			<property name="allowStaticMemberImports" value="false"/>
		</module>
		<module name="UnusedImports">
			<property name="processJavadoc" value="true"/>
		</module>
		<module name="RedundantImport"/>
		<module name="IllegalImport">
			<property name="illegalPkgs" value="sun, com.sun"/>
		</module>

		<!-- ===== 命名（教学代码的可读性基础）===== -->
		<module name="PackageName">
			<property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
		</module>
		<module name="TypeName"/>
		<module name="MethodName"/>
		<module name="ParameterName"/>
		<module name="LocalVariableName"/>
		<module name="MemberName"/>
		<module name="ConstantName"/>
		<module name="StaticVariableName"/>
		<!-- 禁止单字母变量名（循环计数 i 允许）-->
		<module name="LocalVariableName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
			<property name="allowOneCharVarInForLoop" value="true"/>
		</module>

		<!-- ===== 文档（公开 API 必须能被读者理解）===== -->
		<module name="MissingJavadocType">
			<property name="scope" value="public"/>
			<property name="excludeScope" value="private"/>
		</module>
		<module name="MissingJavadocMethod">
			<property name="scope" value="public"/>
			<property name="minLineCount" value="2"/>
			<property name="allowMissingPropertyJavadoc" value="true"/>
			<property name="allowedAnnotations" value="Override, Test, BeforeEach, AfterEach, BeforeAll, AfterAll"/>
		</module>
		<module name="JavadocStyle">
			<property name="scope" value="public"/>
			<property name="checkFirstSentence" value="false"/>
			<property name="checkEmptyJavadoc" value="true"/>
		</module>

		<!-- ===== 规模（单章代码要能被一口读完）===== -->
		<module name="MethodLength">
			<property name="max" value="40"/>
			<property name="countEmpty" value="false"/>
		</module>
		<module name="ParameterNumber">
			<property name="max" value="5"/>
			<property name="ignoreOverriddenMethods" value="true"/>
		</module>
		<!-- 一个类最多依赖几个「别的抽象」。
		     DefaultListableBeanFactory 是本书唯一的上帝类（图纸、构造器解析、属性填充、值解析、
		     后处理器链、销毁适配器都在这一个类上），第 13 章加销毁后到 11。真实 Spring 的同一个
		     类是 2778 行、耦合 30+ 个类。阈值放到 15：让「框架的代价」显形，而不是靠拆类骗指标。 -->
		<module name="ClassDataAbstractionCoupling">
			<property name="max" value="15"/>
		</module>

		<!-- ===== 代码卫生 ===== -->
		<module name="NeedBraces"/>
		<module name="LeftCurly"/>
		<module name="RightCurly">
			<property name="option" value="alone"/>
		</module>
		<module name="DefaultComesLast"/>
		<module name="FallThrough"/>
		<module name="EqualsHashCode"/>
		<module name="SimplifyBooleanExpression"/>
		<module name="SimplifyBooleanReturn"/>
		<module name="StringLiteralEquality"/>
		<module name="EmptyStatement"/>
		<module name="MultipleVariableDeclarations"/>
		<module name="OneStatementPerLine"/>
		<module name="UpperEll"/>
		<module name="ModifierOrder"/>
		<module name="EqualsAvoidNull"/>
		<module name="MissingSwitchDefault"/>
		<module name="NoFinalizer"/>
		<!--
			只禁 Throwable 与 Error，不禁 Exception：容器的回调边界（InitializingBean#afterPropertiesSet
			声明 throws Exception）决定了框架必须 catch (Exception)，真实 Spring 在
			AbstractAutowireCapableBeanFactory#initializeBean(:1821) 甚至 catch (Throwable)。
			吞掉 Error（OOM、StackOverflowError）才是真正危险的，所以那条继续禁。
			真实 Spring 6.2.x 的 src/checkstyle/checkstyle.xml 根本没有 IllegalCatch 这一条。
		-->
		<module name="IllegalCatch">
			<property name="illegalClassNames" value="java.lang.Throwable, java.lang.Error"/>
		</module>
		<!--
			允许 throws Throwable（继续禁 Error）。理由：这一条禁的是「乱声明 throws Throwable」，
			但 JDK 自己就规定了两个必须这么写的位置——java.lang.reflect.InvocationHandler#invoke
			与 java.lang.invoke.MethodHandle#invoke。第 21 章的拦截器要原样透出用户方法体抛出的任何东西，
			签名只能跟它们一样。真实 Spring 的 CGLIB 回调 MethodInterceptor#intercept 也是 throws Throwable。
		-->
		<module name="IllegalThrows">
			<property name="illegalClassNames" value="java.lang.Error"/>
		</module>
		<module name="DeclarationOrder"/>
		<module name="OverloadMethodsDeclarationOrder"/>

		<!-- ===== 空白与换行 ===== -->
		<module name="WhitespaceAround">
			<property name="allowEmptyConstructors" value="true"/>
			<property name="allowEmptyMethods" value="true"/>
			<property name="allowEmptyTypes" value="true"/>
			<property name="allowEmptyLambdas" value="true"/>
		</module>
		<module name="GenericWhitespace"/>
		<module name="NoWhitespaceBefore"/>
		<module name="WhitespaceAfter"/>
		<module name="EmptyLineSeparator">
			<property name="allowNoEmptyLineBetweenFields" value="true"/>
		</module>
	</module>
</module>
